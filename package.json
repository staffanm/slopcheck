    "prebuild": "node scripts/check-model.js"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "mammoth": "1.12.3",
    "onnxruntime-web": "1.30.0",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.3.0"
  }
}
